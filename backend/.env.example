# Database connection string (required)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intent_to_cart

# Redis connection string (required)
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# CORS allowed origins (optional, comma-separated)
# Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Application environment (required: development, staging, or production)
APP_ENV=development

# Debug mode (optional, default: False)
DEBUG=False
